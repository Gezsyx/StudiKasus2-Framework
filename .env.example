# Salin file ini menjadi `.env` lalu isi nilainya.
# File `.env` tidak ikut di-commit (lihat .gitignore).

PORT=3000
NODE_ENV=development

# Database configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=isi_password_postgres_anda
DB_DATABASE=studikasus2uts

# Opsional. Default: true saat NODE_ENV bukan "production".
# true  = tabel dibuat/disesuaikan otomatis dari entity saat aplikasi start
# false = jangan ubah skema otomatis (gunakan migrasi)
# DB_SYNCHRONIZE=true
