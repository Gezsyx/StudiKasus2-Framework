  "info": {
    "title": "E-commerce Management System API",
    "description": "Backend pengelolaan toko online: produk, kategori, pelanggan, pesanan, dan detail pesanan.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "stock": {
            "type": "number",
            "minimum": 0
          },
          "categoryId": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "price",
          "stock",
          "categoryId"
        ]
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "address",
          "orders"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "customerId": {
            "type": "number"
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "status": {
            "enum": [
              "pending",
              "paid",
              "shipped",
              "completed",
              "cancelled"
            ],
            "type": "string"
          },
          "totalAmount": {
            "type": "number"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          }
        },
        "required": [
          "id",
          "customerId",
          "customer",
          "status",
          "totalAmount",
          "createdAt",
          "updatedAt",
          "items"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "orderId": {
            "type": "number"
          },
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "productId": {
            "type": "number"
          },
          "product": {
            "$ref": "#/components/schemas/Product"
          },
          "quantity": {
            "type": "number"
          },
          "unitPrice": {
            "type": "number",
            "description": "Harga satuan produk pada saat transaksi (snapshot, tidak berubah walau harga produk berubah)."
          },
          "subtotal": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "orderId",
          "order",
          "productId",
          "product",
          "quantity",
          "unitPrice",
          "subtotal"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number"
          },
          "stock": {
            "type": "number"
          },
          "categoryId": {
            "type": "number"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "orderItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "price",
          "stock",
          "categoryId",
          "category",
          "orderItems"
        ]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "products"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {}
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCategoryDto": {
        "type": "object",
        "properties": {}
      },
      "CreateCustomerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "maxLength": 30
          },
          "address": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "email"
        ]
      },
      "UpdateCustomerDto": {
        "type": "object",
        "properties": {}
      },
      "OrderItemInputDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "number"
          },
          "quantity": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "productId",
          "quantity"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": "number"
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemInputDto"
            }
          }
        },
        "required": [
          "customerId",
          "items"
        ]
      },
      "UpdateOrderDto": {
